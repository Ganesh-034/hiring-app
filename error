        required_vars=(
          VITE_MSAL_CLIENT_ID
          VITE_MSAL_TENANT_ID
          VITE_MSAL_REDIRECT_URI
          VITE_MSAL_SCOPES
        )
        for var in "${required_vars[@]}"; do
          if [ -z "${!var}" ]; then
            echo "##vso[task.logissue type=error]Environment variable '$var' is not set."
            exit 1
          else
            echo "✓ $var is set"
          fi
        done
      displayName: 'Validate Vite Environment Variables'
      env:
