Backend:

1. Backend-Prod-dependencies-Failure-Spike

dependencies
| where timestamp > ago(10m)
| where success == false
| summarize FailureCount = count()

signal type --log search, failurecount 10min, threshold -5

2. Backend-prod-http-5XX-ERRORS

requests
| where timestamp > ago(10m)
| extend statusCode = toint(resultCode)
| where statusCode >= 500
| summarize FailureCount = count(), Total = count()

signal type-log search, FailureCount 10min, threshold -3

3. Backend-Prod-High-response-time

requests
| where timestamp > ago(10m)
| summarize P95 = percentile(duration, 95)
| where P95 > 2000

signal type-log search, Tablerows 10min, threshold -1

4. Backend-Prod-Js-Exceptions

exceptions
| where timestamp > ago(10m)
| where problemId !contains "404"
| where problemId != "OperationNotFound"
| where type !contains "Http"
| summarize count()

signal type-log search, count total 10min, threshold -10

5.backend-prod-availabilityResults

metric--availability --every 5 mints, 3 locations


Frontend:

1. Frontend prod Js-Exceptions

exceptions
| where timestamp > ago(15m)
| summarize exceptionCount = count() 

signal type-log search, exceptionCount 10min, threshold -5

2. Prod-SWA-backend failures and auth errors

dependencies
| where timestamp > ago(10m)
| where target contains "soc-watchtower-api.azure-api.net"
| extend statusCode = toint(resultCode)
| summarize
    backendFailures = countif(statusCode >= 500),
    authErrors = countif(statusCode in (401, 403))
| extend totalIssues = backendFailures + authErrors

signal type-log search, totalIssues 10min, threshold -3

3. prod-swa-no-telemetry-30mints

union availabilityResults, pageViews, dependencies, exceptions
| where timestamp > ago(30m)
| summarize TotalTelemetry=count()

signal type-log search, TotalTelemetry 30min, threshold -1

4. Dev-Backend-Hight-CPU-Ususge

metric --CPU percetage --average-- greater than 80 --30mints

5. Dev-Backend-Hight-memory-Ususge

metric --memory percetage --average-- greater than 90 --30mints

6. forntend-prod-website-slow-responce

metric-- availability test duration, avergae, greter than 3000ms

7. Frontend-prod-homepage-test

