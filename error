#!/bin/bash

set -e

############################################
# Variables
############################################

DATE=$(date +%Y-%m-%d-%H-%M)

HOME_DIR="$HOME"

SCOUT_DIR="$HOME/tools/ScoutSuite"

REPORT_FOLDER="scoutsuite-report"

ZIP_NAME="scoutsuite-report-$DATE.zip"

STORAGE_ACCOUNT="scoutsuiterept"

CONTAINER_NAME="reports"

LOG_DIR="$HOME/logs"

mkdir -p "$LOG_DIR"

LOGFILE="$LOG_DIR/scoutsuite.log"

echo "===================================" >> "$LOGFILE"
echo "Started : $(date)" >> "$LOGFILE"
echo "===================================" >> "$LOGFILE"

############################################
# Login using Managed Identity
############################################

az login --identity >> "$LOGFILE" 2>&1

############################################
# Go to ScoutSuite Folder
############################################

cd "$SCOUT_DIR"

############################################
# Activate Python Environment
############################################

source scoutsuite-env/bin/activate

############################################
# Remove Old Report Folder
############################################

rm -rf scoutsuite-report

############################################
# Run Scout Suite
############################################

python scout.py azure -c >> "$LOGFILE" 2>&1

############################################
# Create ZIP
############################################

zip -r "$ZIP_NAME" "$REPORT_FOLDER" >> "$LOGFILE" 2>&1

############################################
# Upload to Blob Storage
############################################

az storage blob upload \
--account-name "$STORAGE_ACCOUNT" \
--container-name "$CONTAINER_NAME" \
--name "$ZIP_NAME" \
--file "$ZIP_NAME" \
--auth-mode login \
--overwrite true >> "$LOGFILE" 2>&1

echo "Upload Completed" >> "$LOGFILE"

############################################
# Finished
############################################

echo "Completed : $(date)" >> "$LOGFILE"
