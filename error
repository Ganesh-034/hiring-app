      condition: always()
      inputs:
        PathtoPublish: 'lint-reports'
        ArtifactName: 'CodeQualityReports-ESLint'

    # Fail on ESLint errors - Branch logic inside
    - task: Bash@3
      displayName: 'Validate ESLint Results'
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          
          if [ ! -f lint-reports/eslint-report.json ]; then
            echo "##vso[task.logissue type=warning]ESLint report not found"
            exit 0
          fi
          
          # Determine if we're on main branch
          if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
              IS_MAIN="true"
          else
            IS_MAIN="false"
          fi
          
          # Export for node process
          export IS_MAIN  
          
          node <<'EOF'
          const fs = require('fs');
          const report = JSON.parse(fs.readFileSync('lint-reports/eslint-report.json', 'utf8'));
          
          const errorCount = report.reduce((sum, file) => sum + file.errorCount, 0);
          const warningCount = report.reduce((sum, file) => sum + file.warningCount, 0);
          
          console.log('\n📊 ESLint Results:');
          console.log('   Errors: ' + errorCount);
          console.log('   Warnings: ' + warningCount + '\n');
          
          const isMainBranch = process.env.IS_MAIN === 'true';
          
          if (errorCount > 0) {
            if (isMainBranch) {
              console.error('❌ ESLint errors found in main branch - FAILING BUILD');
              process.exit(1);
            } else {
              console.warn('⚠️  ESLint errors found in dev branch - continuing (non-blocking)');
              process.exit(0);
            }
          } else {
            console.log('✅ No ESLint errors found');
          }
          EOF
      env:
        IS_MAIN: ${{ variables.IS_MAIN }}

    # Publish ESLint Results
    - task: PublishTestResults@2
      displayName: 'Publish ESLint Results'
      condition: always()
      inputs:
        testResultsFiles: '**/eslint-report.xml'
        testRunTitle: 'ESLint Code Quality'
        mergeTestResults: true

    # ===========================
    # CODE QUALITY - Prettier
    # ===========================
    - script: |
        echo "Checking code formatting with Prettier..."
        mkdir -p lint-reports
        npm run prettier:check > lint-reports/prettier-report.txt 2>&1 || true
      displayName: 'Run Prettier Check'

    # Fail on Prettier issues - Branch logic inside
    - task: Bash@3
      displayName: 'Validate Prettier Results'
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          
          if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
            echo "🔒 Running Prettier in BLOCKING mode (main/master branch)"
            if ! npm run prettier:check; then
              echo "##vso[task.logissue type=error]Prettier formatting issues found - FAILING BUILD"
              exit 1
            fi
            echo "✅ Code formatting is correct"
          else
            echo "✓ Prettier check completed (non-blocking in dev)"
          fi

    # Publish Lint Reports
    - task: PublishBuildArtifacts@1
      displayName: 'Publish Lint Reports'
      condition: always()
      inputs:
        PathtoPublish: 'lint-reports'
        ArtifactName: 'CodeQualityReports'

    # ===========================
    # UNIT TESTS
    # ===========================
    - script: |
        echo "Installing test dependencies..."
        npm install --save-dev jest-junit
      displayName: 'Install Test Dependencies'

    - script: |
        echo "Running unit tests with coverage..."
        npm test -- --coverage --coverageReporters=cobertura --coverageReporters=html --reporters=default --reporters=jest-junit || true
      displayName: 'Run Unit Tests with Coverage'
      continueOnError: true

    # Publish Test Results
    - task: PublishTestResults@2
      displayName: 'Publish Unit Test Results'
      condition: always()
      inputs:
        testResultsFiles: '**/junit.xml'
        testRunTitle: 'Unit Tests'
        mergeTestResults: true

    # Publish Coverage Report
    - task: PublishCodeCoverageResults@1
      displayName: 'Publish Code Coverage'
      condition: always()
      inputs:
        codeCoverageTool: 'Cobertura'
        summaryFileLocation: '$(System.DefaultWorkingDirectory)/coverage/cobertura-coverage.xml'
        reportDirectory: '$(System.DefaultWorkingDirectory)/coverage'

    # NEW: Validate Test Results Based on Branch
    - task: Bash@3
      displayName: 'Validate Test Results'
      condition: always()
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          
          echo "Validating unit test results..."
          
          # Find junit.xml
          JUNIT_FILE=""
          if [ -f junit.xml ]; then
            JUNIT_FILE="junit.xml"
          elif [ -f test-results/junit.xml ]; then
            JUNIT_FILE="test-results/junit.xml"
          else
            echo "##vso[task.logissue type=warning]Test results file not found"
            
            if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
              echo "##vso[task.logissue type=error]FAILING BUILD - Test results missing in main/master"
              exit 1
            else
              echo "⚠️  Continuing - Test results missing in development (non-blocking)"
              exit 0
            fi
          fi
          
          # Parse test results
          FAILURES=$(grep -oP 'failures="\K[0-9]+' "$JUNIT_FILE" | head -1 || echo "0")
          ERRORS=$(grep -oP 'errors="\K[0-9]+' "$JUNIT_FILE" | head -1 || echo "0")
          TESTS=$(grep -oP 'tests="\K[0-9]+' "$JUNIT_FILE" | head -1 || echo "0")
          
          echo ""
          echo "📊 Test Results Summary:"
          echo "   Total Tests: $TESTS"
          echo "   Failures: $FAILURES"
          echo "   Errors: $ERRORS"
          echo ""
          
          TOTAL_ISSUES=$((FAILURES + ERRORS))
          
          if [ $TOTAL_ISSUES -gt 0 ]; then
            if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
              echo "##vso[task.logissue type=error]❌ $TOTAL_ISSUES test(s) failed in main/master - FAILING BUILD"
              exit 1
            else
              echo "##vso[task.logissue type=warning]⚠️  $TOTAL_ISSUES test(s) failed in development - continuing (non-blocking)"
              echo "⚡ Please fix these tests before merging to main!"
              exit 0
            fi
          else
            echo "✅ All $TESTS tests passed"
          fi

    # Enforce Coverage Threshold - Branch logic inside
    - task: Bash@3
      displayName: 'Validate Coverage Threshold (80%)'
      condition: always()
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          
          echo "Validating code coverage threshold..."
          
          if [ ! -f coverage/cobertura-coverage.xml ]; then
            echo "##vso[task.logissue type=warning]Coverage report not found"
            
            if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
              echo "##vso[task.logissue type=error]Coverage report missing in main/master - FAILING BUILD"
              exit 1
            else
              echo "⚠️  Coverage report missing in development - continuing (non-blocking)"
              exit 0
            fi
          fi
          
          # Determine branch mode
          if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
            IS_MAIN="true"
            echo "🔒 Running coverage validation in BLOCKING mode (main/master)"
          else
            IS_MAIN="false"
            echo "🔓 Running coverage validation in NON-BLOCKING mode (development)"
          fi
          
          # Parse coverage
          LINE_RATE=$(grep -oP 'line-rate="\K[0-9.]+' coverage/cobertura-coverage.xml | head -1)
          COVERAGE=$(echo "$LINE_RATE * 100" | bc)
          THRESHOLD=80
          
          echo ""
          echo "📊 Code Coverage Report:"
          printf "   Line Coverage: %.2f%%\n" "$COVERAGE"
          echo "   Required Threshold: ${THRESHOLD}%"
          echo "   Branch: $(Build.SourceBranchName)"
          echo ""
          
          # Compare coverage
          if (( $(echo "$COVERAGE < $THRESHOLD" | bc -l) )); then
            DEFICIT=$(echo "$THRESHOLD - $COVERAGE" | bc)
            
            if [ "$IS_MAIN" = "true" ]; then
              echo "##vso[task.logissue type=error]❌ COVERAGE CHECK FAILED"
              printf "##vso[task.logissue type=error]Line coverage (%.2f%%) is below ${THRESHOLD}%% threshold\n" "$COVERAGE"
              printf "##vso[task.logissue type=error]Need %.2f%% more coverage - FAILING BUILD\n" "$DEFICIT"
              exit 1
            else
              echo "##vso[task.logissue type=warning]⚠️  COVERAGE WARNING"
              printf "##vso[task.logissue type=warning]Line coverage (%.2f%%) is below ${THRESHOLD}%% threshold\n" "$COVERAGE"
              printf "##vso[task.logissue type=warning]Need %.2f%% more coverage\n" "$DEFICIT"
              echo "⚡ Action Required: Add more tests before merging to main!"
              exit 0
            fi
          else
            SURPLUS=$(echo "$COVERAGE - $THRESHOLD" | bc)
            echo "✅ COVERAGE CHECK PASSED"
            printf "   Line coverage (%.2f%%) meets ${THRESHOLD}%% threshold\n" "$COVERAGE"
            printf "   Surplus: +%.2f%%\n" "$SURPLUS"
          fi

    - task: Bash@3
      displayName: 'Quality Gates Summary'
      condition: always()
      inputs:
        targetType: 'inline'
        script: |
          echo ""
          echo "════════════════════════════════════════════════════════════"
          echo "                    QUALITY GATES SUMMARY"
          echo "════════════════════════════════════════════════════════════"
          echo ""
          echo "Branch: $(Build.SourceBranchName)"
          echo "Build: $(Build.BuildNumber)"
          echo ""
          
          if [[ "$(Build.SourceBranch)" == "refs/heads/main" ]] || [[ "$(Build.SourceBranch)" == "refs/heads/master" ]]; then
            echo "🔒 MODE: PRODUCTION (All checks BLOCKING)"
            echo ""
            echo "Required Quality Standards:"
            echo "  ✓ Unit Tests: MUST PASS (0 failures)"
            echo "  ✓ Coverage: MUST BE ≥ 80%"
            echo "  ✓ ESLint: 0 errors"
            echo "  ✓ Security: No HIGH/CRITICAL"
          else
            echo "🔓 MODE: DEVELOPMENT (Checks NON-BLOCKING)"
            echo ""
            echo "Quality Monitoring:"
            echo "  📊 Unit Tests: Report generated"
            echo "  📊 Coverage: Report generated"
            echo "  ⚠️  Fix issues before merging to main!"
          fi
          
          echo ""
          echo "════════════════════════════════════════════════════════════" 

    # ===========================
    # BUILD APPLICATION
    # ===========================
    - script: |
        set -euo pipefail
        echo "Building application..."
        npm run build
        echo "✅ Build completed successfully"
      displayName: 'Build Application'

    # Publish Build Artifacts
    - task: PublishBuildArtifacts@1
      displayName: 'Publish Build Artifacts'
      inputs:
        PathtoPublish: 'dist'
        ArtifactName: 'build-output'

# ===========================
# STAGE 4: DEPLOYMENT
# ===========================
- stage: Deploy
  displayName: 'Deploy to Azure Static Web Apps'
  dependsOn: BuildAndCodeQuality
  condition: |
    or(
      and(
        succeeded(),
        eq(variables['Build.SourceBranchName'], 'main')
      ),
      and(
        in(dependencies.BuildAndCodeQuality.result, 'Succeeded', 'SucceededWithIssues', 'Failed'),
        eq(variables['Build.SourceBranchName'], 'development')
      )
    )
  # condition: |
  #   and(
  #     succeeded(),
  #     or(
  #       eq(variables['Build.Reason'], 'Manual'),
  #       eq(variables['Build.Reason'], 'PullRequest'),
  #       eq(variables['Build.Reason'], 'IndividualCI')
  #     )
  #   )
  jobs:
  # ===========================
  # DIAGNOSTIC JOB
  # ===========================
  - job: deployment_diagnostics
    displayName: 'Deployment Diagnostics'
    pool:
      vmImage: ubuntu-latest
    steps:
    - task: Bash@3
      displayName: 'Show Deployment Variables'
      inputs:
        targetType: 'inline'
        script: |
          echo "════════════════════════════════════════════════════════"
          echo "  DEPLOYMENT CONDITION DIAGNOSTICS"
          echo "════════════════════════════════════════════════════════"
          echo ""
          echo "Build Information:"
          echo "  Build.Reason:           '$(Build.Reason)'"
          echo "  Build.SourceBranch:     '$(Build.SourceBranch)'"
          echo "  Build.SourceBranchName: '$(Build.SourceBranchName)'"
          echo "  Build.RequestedFor:     '$(Build.RequestedFor)'"
          echo "  Build.DefinitionName:   '$(Build.DefinitionName)'"
          echo ""
          echo "System Information:"
          echo "  System.PullRequest.IsFork: '$(System.PullRequest.IsFork)'"
          echo "  System.PullRequest.PullRequestId: '$(System.PullRequest.PullRequestId)'"
          echo ""
          echo "Agent Information:"
          echo "  Agent.JobStatus: '$(Agent.JobStatus)'"
          echo ""
          echo "Previous Stage:"
          echo "  BuildAndCodeQuality Result: In Progress/Not Available at this point"
          echo ""
          echo "════════════════════════════════════════════════════════"
          echo ""
          echo "Checking Build.Reason against your conditions:"
          echo ""
          
          case "$(Build.Reason)" in
            "Manual")
              echo "  ✅ Matches: Manual"
              ;;
            "PullRequest")
              echo "  ✅ Matches: PullRequest"
              ;;
            "IndividualCI")
              echo "  ✅ Matches: IndividualCI"
              ;;
            "BatchedCI")
              echo "  ⚠️  Build.Reason is 'BatchedCI' (not in your condition)"
              ;;
            "Schedule")
              echo "  ⚠️  Build.Reason is 'Schedule' (not in your condition)"
              ;;
            "BuildCompletion")
              echo "  ⚠️  Build.Reason is 'BuildCompletion' (not in your condition)"
              ;;
            *)
              echo "  ❌ Build.Reason is '$(Build.Reason)' - UNKNOWN/NOT MATCHED"
              ;;
          esac
          
          echo ""
          echo "Branch Check:"
          if [[ "$(Build.SourceBranchName)" == "development" ]]; then
            echo "  ✅ Branch is 'development' - OK for deployment"
          elif [[ "$(Build.SourceBranchName)" == "main" ]] || [[ "$(Build.SourceBranchName)" == "master" ]]; then
            echo "  ✅ Branch is '$(Build.SourceBranchName)' - OK for deployment"
          else
            echo "  ⚠️  Branch is '$(Build.SourceBranchName)' - May not be configured"
          fi
          
          echo ""
          echo "════════════════════════════════════════════════════════"

  # ===========================
  # DEVELOPMENT DEPLOYMENT
  # ===========================
  - deployment: deploy_development
    displayName: Deploy to Development
    dependsOn: deployment_diagnostics
    condition: |
      and(
        succeeded(),
        or(
          eq(variables['Build.SourceBranchName'], 'development'),
          eq(variables['Build.SourceBranch'], 'refs/heads/development')
        )
      )
    environment: development
    pool:
      vmImage: ubuntu-latest
    variables:
    - group: azure-static-web-apps-ashy-beach-variable-group
    
    strategy:
      runOnce:
        deploy:
          steps:
          - checkout: self
            displayName: 'Checkout Repository'

          - task: NodeTool@0
            inputs:
              versionSpec: '20.x'
            displayName: 'Install Node.js v20'

          # Download to System.DefaultWorkingDirectory
          - task: DownloadPipelineArtifact@2
            displayName: 'Download Build Artifacts'
            inputs:
              buildType: 'current'
              artifactName: 'build-output'
              targetPath: '$(System.DefaultWorkingDirectory)/dist'

          - task: Bash@3
            displayName: 'Verify Build Artifacts'
            inputs:
              targetType: 'inline'
              script: |
                set -euo pipefail
                
                echo "════════════════════════════════════════════════"
                echo "  BUILD ARTIFACTS VERIFICATION"
                echo "════════════════════════════════════════════════"
                echo ""
                
                DIST_PATH="$(System.DefaultWorkingDirectory)/dist"
                echo "📂 Artifact Path: $DIST_PATH"
                echo ""
                
                if [ ! -d "$DIST_PATH" ]; then
                  echo "##vso[task.logissue type=error]❌ Artifacts directory not found"
                  echo "Working Directory Contents:"
                  ls -la "$(System.DefaultWorkingDirectory)" || true
                  echo ""
                  echo "Pipeline Workspace Contents:"
                  ls -la "$(Pipeline.Workspace)" || true
                  exit 1
                fi
                
                echo "✅ Artifacts directory found"
                echo ""
                echo "📊 Contents:"
                ls -lah "$DIST_PATH"
                echo ""
                
                if [ ! -f "$DIST_PATH/index.html" ]; then
                  echo "##vso[task.logissue type=error]❌ index.html not found"
                  exit 1
                fi
                
                echo "✅ index.html found"
                TOTAL_SIZE=$(du -sh "$DIST_PATH" | cut -f1)
                echo "📦 Total Size: $TOTAL_SIZE"
                FILE_COUNT=$(find "$DIST_PATH" -type f | wc -l)
                echo "📄 File Count: $FILE_COUNT"
                echo ""
                echo "════════════════════════════════════════════════"

          # app_location path
          - task: AzureStaticWebApp@0
            displayName: 'Deploy to Azure Static Web Apps (Development)'
            inputs:
              azure_static_web_apps_api_token: $(AZURE_STATIC_WEB_APPS_API_TOKEN_ASHY_BEACH)
              app_location: 'dist'  # ✅ Relative to working directory
              api_location: ''
              output_location: ''
              skip_app_build: true

          - task: Bash@3
            displayName: 'Deployment Summary'
            condition: always()
            inputs:
              targetType: 'inline'
              script: |
                echo ""
                echo "════════════════════════════════════════════════════════"
                if [ "$AGENT_JOBSTATUS" = "Succeeded" ]; then
                  echo "  ✅ DEVELOPMENT DEPLOYMENT SUCCESSFUL"
                  echo ""
                  echo "Your app should be available at:"
                  echo "  https://<your-static-web-app>.azurestaticapps.net"
                else
                  echo "  ❌ DEPLOYMENT FAILED"
                  echo ""
                  echo "Check the logs above for error details"
                fi
                echo "════════════════════════════════════════════════════════"
                echo ""
                echo "Environment:    Development"
                echo "Branch:         $(Build.SourceBranchName)"
                echo "Build Number:   $(Build.BuildNumber)"
                echo "Commit:         $(Build.SourceVersion)"
                echo ""
                echo "════════════════════════════════════════════════════════"

