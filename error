          echo "VITE_MSAL_REDIRECT_URI=$VITE_MSAL_REDIRECT_URI"
          echo "VITE_MSAL_SCOPES=$VITE_MSAL_SCOPES"
        } > .env
        echo "✓ .env file created"
      displayName: 'Create .env File'
