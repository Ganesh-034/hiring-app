        testResultsFiles: '**/eslint-report.xml'
        searchFolder: '$(System.DefaultWorkingDirectory)/lint-reports'
        testRunTitle: 'ESLint Code Quality'
        mergeTestResults: true
        failTaskOnFailedTests: false

    - task: PublishBuildArtifacts@1
