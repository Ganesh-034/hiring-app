PURGE_CMD="acr purge \
  --filter 'soc-watchtower-backend:^[0-9]+$' \
  --filter 'presidioapp:^[0-9]+$' \
  --ago 0d \
  --keep 10 \
  --untagged"

az acr task create \
  --name acr-image-cleanup \
  --registry acrsocwatchtowerbackenddev \
  --cmd "$PURGE_CMD" \
  --schedule "0 2 * * *" \
  --context /dev/null
