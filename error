param()

#############################################################
# Variables
#############################################################

$SubscriptionId = "0c123281-74e2-43d2-bbc3-8526be0786bc"
$ResourceGroupName = "soc-watchtower-dev"
$VMName = "Scoutsuite-VM"

$ScriptPath = "/home/azureuser/scripts/run_scoutsuite.sh"
$StatusFile = "/tmp/scoutsuite.status"

#############################################################
# Login
#############################################################

Write-Output "=============================================="
Write-Output "Connecting to Azure..."
Write-Output "=============================================="

Connect-AzAccount -Identity | Out-Null
Set-AzContext -SubscriptionId $SubscriptionId | Out-Null

Write-Output "Connected Successfully."

#############################################################
# Start VM
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Starting VM..."
Write-Output "=============================================="

Start-AzVM `
    -ResourceGroupName $ResourceGroupName `
    -Name $VMName | Out-Null

#############################################################
# Wait until VM Running
#############################################################

Write-Output ""
Write-Output "Waiting for VM to start..."

do
{
    Start-Sleep -Seconds 20

    $status = Get-AzVM `
        -ResourceGroupName $ResourceGroupName `
        -Name $VMName `
        -Status

    $powerState = (
        $status.Statuses |
        Where-Object {$_.Code -like "PowerState/*"}
    ).DisplayStatus

    Write-Output $powerState

}
until ($powerState -eq "VM running")

Write-Output ""
Write-Output "VM Started Successfully."

#############################################################
# Execute ScoutSuite
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Running ScoutSuite..."
Write-Output "=============================================="

$ShellScript = @"
echo "Current User:"
whoami

echo "Current Directory:"
pwd

echo "HOME=\$HOME"

echo "Making script executable..."
chmod +x $ScriptPath

echo "Running ScoutSuite Script..."
bash $ScriptPath

echo
echo "================ STATUS FILE ================"
cat $StatusFile || echo "Status file not found"

echo
echo "================ LAST 100 LOG LINES ================"
tail -100 /home/azureuser/logs/scoutsuite.log || echo "Log file not found"

echo
echo "================ END ================"
"@

try
{
    $result = Invoke-AzVMRunCommand `
        -ResourceGroupName $ResourceGroupName `
        -VMName $VMName `
        -CommandId "RunShellScript" `
        -ScriptString $ShellScript
}
catch
{
    Write-Output "Run Command Failed"
    Write-Output $_.Exception.Message
    throw
}

#############################################################
# Print VM Output
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "RUN COMMAND OUTPUT"
Write-Output "=============================================="

$result.Value.Message

#############################################################
# Success Check
#############################################################

if ($result.Value.Message -match "SCOUTSUITE_SUCCESS")
{
    Write-Output ""
    Write-Output "=============================================="
    Write-Output "ScoutSuite completed successfully."
    Write-Output "ZIP uploaded successfully."
    Write-Output "=============================================="
}
else
{
    Write-Output ""
    Write-Output "=============================================="
    Write-Output "ScoutSuite execution FAILED."
    Write-Output "VM will remain running for investigation."
    Write-Output "=============================================="

    throw "ScoutSuite did not complete successfully."
}

#############################################################
# Stop VM
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Stopping VM..."
Write-Output "=============================================="

Stop-AzVM `
    -ResourceGroupName $ResourceGroupName `
    -Name $VMName `
    -Force | Out-Null

Write-Output ""
Write-Output "VM Stopped Successfully."

Write-Output ""
Write-Output "=============================================="
Write-Output "ScoutSuite Automation Completed Successfully"
Write-Output "=============================================="
