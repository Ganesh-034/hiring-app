param()

#############################################################
# Variables
#############################################################

$SubscriptionId = "0c123281-74e2-43d2-bbc3-8526be0786bc"

$ResourceGroupName = "soc-watchtower-dev"

$VMName = "Scoutsuite-VM"

$ScriptPath = "/home/azureuser/scripts/run_scoutsuite.sh"

$StatusFile = "/tmp/scoutsuite.status"

#############################################################
# Login
#############################################################

Write-Output "=============================================="
Write-Output "Connecting to Azure..."
Write-Output "=============================================="

Connect-AzAccount -Identity

Set-AzContext -SubscriptionId $SubscriptionId

Write-Output "Connected Successfully."

#############################################################
# Start VM
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Starting VM..."
Write-Output "=============================================="

Start-AzVM `
    -ResourceGroupName $ResourceGroupName `
    -Name $VMName

#############################################################
# Wait until VM starts
#############################################################

Write-Output ""
Write-Output "Waiting for VM to start..."

do
{
    Start-Sleep -Seconds 20

    $status = Get-AzVM `
        -ResourceGroupName $ResourceGroupName `
        -Name $VMName `
        -Status

    $powerState = (
        $status.Statuses |
        Where-Object {$_.Code -like "PowerState/*"}
    ).DisplayStatus

    Write-Output $powerState

}
until ($powerState -eq "VM running")

Write-Output ""
Write-Output "VM Started Successfully."

#############################################################
# Execute ScoutSuite
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Running ScoutSuite..."
Write-Output "=============================================="

$result = Invoke-AzVMRunCommand `
    -ResourceGroupName $ResourceGroupName `
    -VMName $VMName `
    -CommandId "RunShellScript" `
    -ScriptString @(
        "chmod +x $ScriptPath",
        "bash $ScriptPath",
        "echo",
        "========== STATUS ==========",
        "cat $StatusFile || true",
        "echo",
        "========== LAST 50 LOG LINES ==========",
        "tail -50 /home/azureuser/logs/scoutsuite.log || true",
        "echo",
        "========== EXIT CODE ==========",
        "echo \$?"
    )

Write-Output ""
Write-Output "=============================================="
Write-Output "RUN COMMAND OUTPUT"
Write-Output "=============================================="

$result.Value.Message

#############################################################
# Verify Success
#############################################################

if ($result.Value.Message -match "SCOUTSUITE_SUCCESS")
{
    Write-Output ""
    Write-Output "=============================================="
    Write-Output "ScoutSuite Completed Successfully"
    Write-Output "ZIP uploaded to Storage Account"
    Write-Output "=============================================="
}
else
{
    Write-Output ""
    Write-Output "=============================================="
    Write-Output "ScoutSuite FAILED"
    Write-Output "VM will NOT be stopped."
    Write-Output "Please review the log output above."
    Write-Output "=============================================="

    throw "ScoutSuite execution failed."
}

#############################################################
# Stop VM
#############################################################

Write-Output ""
Write-Output "=============================================="
Write-Output "Stopping VM..."
Write-Output "=============================================="

Stop-AzVM `
    -ResourceGroupName $ResourceGroupName `
    -Name $VMName `
    -Force

Write-Output ""
Write-Output "=============================================="
Write-Output "VM Stopped Successfully"
Write-Output "=============================================="

Write-Output ""
Write-Output "=============================================="
Write-Output "ScoutSuite Automation Completed Successfully"
Write-Output "=============================================="
