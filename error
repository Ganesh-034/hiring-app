#!/bin/bash

##############################################################################
# ScoutSuite Azure Automation Script
##############################################################################

set -u

export HOME=/home/azureuser
export USER=azureuser
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin

STATUS_FILE="/tmp/scoutsuite.status"

echo "RUNNING" > "$STATUS_FILE"

DATE=$(date +"%Y-%m-%d")
TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")

SCOUT_HOME="/home/azureuser/tools/ScoutSuite"
REPORT_FOLDER="$SCOUT_HOME/scoutsuite-report"

ZIP_NAME="scoutsuite-report-$DATE.zip"

LOG_DIR="/home/azureuser/logs"
LOGFILE="$LOG_DIR/scoutsuite.log"

STORAGE_ACCOUNT="scoutsuiterept"
CONTAINER="reports"

mkdir -p "$LOG_DIR"

echo "" >> "$LOGFILE"
echo "===================================================" >> "$LOGFILE"
echo "Started : $TIMESTAMP" >> "$LOGFILE"
echo "===================================================" >> "$LOGFILE"

log() {
    echo "$1"
    echo "$1" >> "$LOGFILE"
}

##############################################################################
# Azure Login
##############################################################################

log "STEP 1 : Azure Login"

az login --identity --allow-no-subscriptions >/dev/null 2>&1

if [ $? -ne 0 ]; then
    log "ERROR: Azure Login Failed"
    echo "FAILED" > "$STATUS_FILE"
    exit 1
fi

##############################################################################
# ScoutSuite Folder
##############################################################################

log "STEP 2 : Change Directory"

cd "$SCOUT_HOME" || {
    log "ERROR: ScoutSuite folder not found"
    echo "FAILED" > "$STATUS_FILE"
    exit 1
}

##############################################################################
# Python Environment
##############################################################################

log "STEP 3 : Activate Python"

source scoutsuite-env/bin/activate || {
    log "ERROR: Python environment activation failed"
    echo "FAILED" > "$STATUS_FILE"
    exit 1
}

##############################################################################
# Remove Previous Report
##############################################################################

log "STEP 4 : Remove Previous Report"

rm -rf "$REPORT_FOLDER"

##############################################################################
# Run ScoutSuite
##############################################################################

log "STEP 5 : Run ScoutSuite"

python scout.py azure -c --no-browser >> "$LOGFILE" 2>&1

SCOUT_RC=$?

log "ScoutSuite Exit Code : $SCOUT_RC"

##############################################################################
# Verify Report Generated
##############################################################################

if [ ! -d "$REPORT_FOLDER" ]; then
    log "ERROR: Report folder not generated"

    echo "FAILED" > "$STATUS_FILE"
    exit 1
fi

log "Report folder verified"

##############################################################################
# Create ZIP
##############################################################################

log "STEP 6 : Create ZIP"

cd "$SCOUT_HOME"

rm -f "$ZIP_NAME"

zip -rq "$ZIP_NAME" scoutsuite-report

if [ ! -f "$ZIP_NAME" ]; then
    log "ERROR: ZIP creation failed"

    echo "FAILED" > "$STATUS_FILE"
    exit 1
fi

log "ZIP created successfully"

##############################################################################
# Upload ZIP
##############################################################################

log "STEP 7 : Upload ZIP"

az storage blob upload \
    --account-name "$STORAGE_ACCOUNT" \
    --container-name "$CONTAINER" \
    --name "$ZIP_NAME" \
    --file "$ZIP_NAME" \
    --overwrite true \
    --auth-mode login >> "$LOGFILE" 2>&1

if [ $? -ne 0 ]; then

    log "ERROR: Blob upload failed"

    echo "FAILED" > "$STATUS_FILE"
    exit 1
fi

log "Upload completed"

##############################################################################
# Verify Upload
##############################################################################

log "STEP 8 : Verify Upload"

UPLOAD_STATUS=$(az storage blob exists \
    --account-name "$STORAGE_ACCOUNT" \
    --container-name "$CONTAINER" \
    --name "$ZIP_NAME" \
    --auth-mode login \
    --query exists \
    -o tsv)

if [ "$UPLOAD_STATUS" != "true" ]; then

    log "ERROR: Upload verification failed"

    echo "FAILED" > "$STATUS_FILE"
    exit 1
fi

log "Upload verified successfully"

##############################################################################
# Success
##############################################################################

echo "SCOUTSUITE_SUCCESS" > "$STATUS_FILE"

log "=============================================="
log "SCOUTSUITE_SUCCESS"
log "ScoutSuite Automation Completed Successfully"
log "=============================================="

exit 0
