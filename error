    - task: Bash@3
      displayName: 'Install ESLint Dependencies'
      inputs:
        targetType: 'inline'
        script: |
          echo "Installing ESLint formatters..."
          npm install --no-save eslint-junit
          echo "✅ Dependencies installed"

    - task: Bash@3
      displayName: 'Run ESLint Analysis'
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          
          echo "Running ESLint..."
          mkdir -p lint-reports
          
          # Run with JSON for detailed analysis
          npx eslint . \
            --format json \
            --output-file lint-reports/eslint-report.json \
            || ESLINT_EXIT_CODE=$?
          
          # Run with JUnit for Azure DevOps
          npx eslint . \
            --format ./node_modules/eslint-junit/index.js \
            --output-file lint-reports/eslint-report.xml \
            || true
          
