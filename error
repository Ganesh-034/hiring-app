name: Renovate-$(Date:yyyyMMdd)

schedules:
  - cron: "0 2 * * 1"
    displayName: Weekly Renovate for demolocal
    branches:
      include:
        - demolocal
    always: true

trigger: none
pr: none

pool:
  vmImage: "ubuntu-latest"

variables:
  RENOVATE_VERSION: "42.0.0"

steps:
  - checkout: self
    displayName: Checkout Repository
    persistCredentials: true
    fetchDepth: 0

  - bash: |
      set -euo pipefail

      echo "======================================"
      echo "Environment Info"
      echo "======================================"
      echo "Node Version:   $(node --version)"
      echo "npm Version:    $(npm --version)"
      echo "Collection URI: $(System.CollectionUri)"
      echo "Team Project:   $(System.TeamProject)"
      echo "Repository:     $(Build.Repository.Name)"
      echo "Source Branch:  $(Build.SourceBranch)"
      echo "Build ID:       $(Build.BuildId)"
      echo ""
    displayName: Show Environment

  - bash: |
      set -euo pipefail

      echo "======================================"
      echo "Installing Renovate v$(RENOVATE_VERSION)"
      echo "======================================"

      npm install -g renovate@$(RENOVATE_VERSION)

      echo ""
      echo "Verifying installation..."
      renovate --version
      echo ""
    displayName: Install Renovate

  - bash: |
      set -euo pipefail

      echo "======================================"
      echo "Renovate Effective Configuration"
      echo "======================================"
      echo "Platform:            azure"
      echo "Repository:          $(System.TeamProject)/$(Build.Repository.Name)"
      echo "Base branch:         demolocal"
      echo "Preset:              config:recommended"
      echo "Require config:      optional"
      echo "Autodiscover:        false"
      echo "Log level:           debug"
      echo ""

      if [ -f "renovate.json" ]; then
        echo "NOTICE: renovate.json exists in the checked-out branch:"
        cat renovate.json
        echo ""
        echo "The Renovate run is controlled by pipeline environment variables."
      else
        echo "No renovate.json found in the checked-out branch."
        echo "The Renovate run will use pipeline environment variables."
      fi

      echo ""
    displayName: Show Renovate Configuration

  - bash: |
      set -euo pipefail

      REPO_FULL="$(System.TeamProject)/$(Build.Repository.Name)"

      echo "======================================"
      echo "Running Renovate"
      echo "======================================"
      echo "Version:        $(renovate --version)"
      echo "Repository:     ${REPO_FULL}"
      echo "Base branch:    demolocal"
      echo "Preset:         config:recommended"
      echo "Require config: optional"
      echo "Log level:      debug"
      echo ""

      if [ -z "$(System.AccessToken)" ]; then
        echo "ERROR: System.AccessToken is empty."
        echo "Make sure the pipeline's build service has repository permissions."
        exit 1
      fi

      echo "Starting Renovate..."
      echo ""

      echo "RENOVATE_PACKAGE_RULES=$RENOVATE_PACKAGE_RULES"
      echo "RENOVATE_PR_CONCURRENT_LIMIT=$RENOVATE_PR_CONCURRENT_LIMIT"
      echo "RENOVATE_BRANCH_CONCURRENT_LIMIT=$RENOVATE_BRANCH_CONCURRENT_LIMIT"
      echo ""

      set +e

      renovate \
        --platform=azure \
        --endpoint="$(System.CollectionUri)" \
        --token="$(System.AccessToken)" \
        "${REPO_FULL}" \
        2>&1 | tee renovate.log

      RENOVATE_EXIT=${PIPESTATUS[0]}

      set -e

      echo ""
      echo "======================================"

      if [ "${RENOVATE_EXIT}" -eq 0 ]; then
        echo "Renovate completed successfully."
      else
        echo "ERROR: Renovate failed with exit code ${RENOVATE_EXIT}."
        exit "${RENOVATE_EXIT}"
      fi

      echo ""
      echo "Verifying Renovate base branch..."

      if grep "Dependency extraction complete" renovate.log \
        | grep -q "baseBranch=demolocal"; then
        echo "SUCCESS: Renovate scanned the demolocal branch."
      else
        echo "ERROR: Could not confirm that Renovate scanned demolocal."
        echo ""
        echo "Relevant log entries:"
        grep -i \
          "baseBranch\|baseBranchPatterns\|Setting current branch\|Dependency extraction complete" \
          renovate.log \
          | head -50 || true
        exit 1
      fi

      if grep "Dependency extraction complete" renovate.log \
        | grep -q "baseBranch=main"; then
        echo "ERROR: Renovate unexpectedly scanned the main branch."
        exit 1
      fi

      echo ""
      echo "Base branch verification completed successfully."
      echo "======================================"
    displayName: Run Renovate
    env:
      LOG_LEVEL: debug
      RENOVATE_AUTODISCOVER: "false"
      RENOVATE_BASE_BRANCH_PATTERNS: '["demolocal"]'
      RENOVATE_REQUIRE_CONFIG: "optional"
      RENOVATE_ONBOARDING: "false"

      RENOVATE_PR_CONCURRENT_LIMIT: "1"
      RENOVATE_BRANCH_CONCURRENT_LIMIT: "1"

      RENOVATE_PACKAGE_RULES: >
        [
          {
            "matchManagers": [".*"],
            "groupName": "all-dependencies"
          }
        ]

  - bash: |
      set -euo pipefail

      echo "======================================"
      echo "Renovate Summary"
      echo "======================================"

      if [ ! -f "renovate.log" ]; then
        echo "No Renovate log file was generated."
        exit 0
      fi

      echo ""
      echo "Base branch details:"
      grep -i \
        "baseBranch\|Setting current branch\|Dependency extraction complete" \
        renovate.log \
        | head -30 || echo "No base branch details found."

      echo ""
      echo "Statistics:"
      grep -i \
        "repository started\|repository finished\|pr created\|branch created\|updates found" \
        renovate.log \
        | head -20 || echo "No statistics found."

      echo ""
      echo "Warnings, last 5:"
      grep "WARN" renovate.log \
        | tail -5 || echo "No warnings found."

      echo ""
      echo "Errors, last 5:"
      grep "ERROR" renovate.log \
        | tail -5 || echo "No errors found."

      echo ""
      echo "======================================"
    displayName: Show Summary
    condition: always()

  - task: PublishPipelineArtifact@1
    displayName: Publish Renovate Log
    condition: always()
    inputs:
      targetPath: "$(System.DefaultWorkingDirectory)/renovate.log"
      artifactName: "renovate-log-$(Build.BuildId)"

  - bash: |
      set -euo pipefail

      echo ""
      echo "=============================================="
      echo "          RENOVATE RUN COMPLETED"
      echo "=============================================="
      echo ""
      echo "Build ID:     $(Build.BuildId)"
      echo "Repository:   $(Build.Repository.Name)"
      echo "Base branch:  demolocal"
      echo ""
      echo "Check Pull Requests:"
      echo "$(System.CollectionUri)$(System.TeamProject)/_git/$(Build.Repository.Name)/pullrequests"
      echo ""
      echo "=============================================="
    displayName: Final Summary
    condition: succeeded()
