name: Azure Static Web Apps CI/CD

# Trigger on push to development and main/master
trigger:
  branches:
    include:
      - development
      # - main
# Trigger on PRs to development and main/master
pr:
  branches:
    include:
      - development
      # - main

# Pipeline-level variables
variables:
  runRenovate: false
  npmAuditForce: false
  coverageThreshold: 80
  npm_config_cache: $(Pipeline.Workspace)/.npm

pool:
  vmImage: ubuntu-latest

# ===========================
# STAGES
# ===========================
stages:
# ===========================
# STAGE 1: DEPENDENCY MANAGEMENT
# ===========================
- stage: DependencyManagement
  displayName: 'Dependency Updates (Renovate)'
  condition: and(succeeded(), eq(variables['runRenovate'], 'true'))
  jobs:
  - job: renovate
    displayName: Run Renovate Bot
    steps:
    - checkout: self

    # Verify PAT Authentication
    - task: PowerShell@2
      displayName: 'Verify Azure DevOps PAT Authentication'
      env:
        AZURE_DEVOPS_PAT: $(AZURE_DEVOPS_PAT)
      inputs:
        targetType: 'inline'
        script: |
          Write-Host "Checking Azure DevOps PAT authentication..."
          $pat = $env:AZURE_DEVOPS_PAT
          if ([string]::IsNullOrEmpty($pat)) {
            Write-Host "##vso[task.logissue type=error]PAT variable is empty or not linked to this job."
            exit 1
          }
          $base64AuthInfo = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes(":$pat"))
          $url = "https://dev.azure.com/tts-devops-prod/_apis/projects?api-version=6.0"
          
          try {
            $response = Invoke-RestMethod -Uri $url -Headers @{Authorization=("Basic {0}" -f $base64AuthInfo)} -Method Get
            Write-Host "PAT authentication successful!"
            $response.value | ForEach-Object { Write-Host "  - $($_.name)" }
          }
          catch {
            Write-Host "##vso[task.logissue type=error]PAT authentication failed: $($_.Exception.Message)"
            exit 1
          }

    # Cache npm for Renovate
    - task: Cache@2
      displayName: 'Cache npm (Renovate CLI)'
      inputs:
        key: 'npm-renovate | "$(Agent.OS)" | renovate-cli-v3'
        path: '$(Pipeline.Workspace)/.npm-cache'
        restoreKeys: |
          npm-renovate | "$(Agent.OS)"

    # Write Renovate config
    - task: Bash@3
      displayName: 'Write Renovate Config'
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          cat > renovate.global.json <<'JSON'
          {
            "platform": "azure",
            "endpoint": "https://dev.azure.com/tts-devops-prod/",
            "repositories": [
              "tts-devops-prod/Security AI Dashboard/_git/soc_watchtower_frontend"
            ],
            "onboarding": false,
            "requireConfig": "optional"
          }
          JSON
          echo "Renovate config written successfully"

    # Install and run Renovate
    - task: Bash@3
      displayName: 'Install & Run Renovate'
      env:
        RENOVATE_PLATFORM: azure
        RENOVATE_TOKEN: $(AZURE_DEVOPS_PAT)
        RENOVATE_ENDPOINT: https://dev.azure.com/tts-devops-prod/
        RENOVATE_LOG_LEVEL: debug
        RENOVATE_LOG_FORMAT: json
        RENOVATE_CONFIG_FILE: $(System.DefaultWorkingDirectory)/renovate.global.json
        npm_config_cache: $(Pipeline.Workspace)/.npm-cache
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          echo "Installing Renovate CLI..."
          npm install -g renovate
          
          echo "Running Renovate..."
          renovate "tts-devops-prod/Security%20AI%20Dashboard/_git/soc_watchtower_frontend"
      continueOnError: true

# ===========================
# STAGE 2: SECURITY SCANNING
# ===========================
- stage: SecurityScanning
  displayName: 'Security Scanning'
  dependsOn: DependencyManagement
  condition: in(dependencies.DependencyManagement.result, 'Succeeded', 'Skipped', 'SucceededWithIssues')
  jobs:
  # ===========================
  # JOB 1: GitLeaks Secret Scanning (MANDATORY)
  # ===========================
  - job: gitleaks_scan
    displayName: 'GitLeaks - Secret Detection'
    steps:
    - checkout: self
      submodules: true

    - task: Bash@3
      displayName: 'Install GitLeaks'
      inputs:
        targetType: 'inline'
        script: |
          set -euo pipefail
          GITLEAKS_VERSION=$(curl -s https://api.github.com/repos/gitleaks/gitleaks/releases/latest | grep tag_name | cut -d '"' -f 4)
          echo "Downloading GitLeaks version $GITLEAKS_VERSION"
          curl -L "https://github.com/gitleaks/gitleaks/releases/download/$GITLEAKS_VERSION/gitleaks_${GITLEAKS_VERSION#v}_linux_x64.tar.gz" -o gitleaks.tar.gz
          tar -xzf gitleaks.tar.gz
          chmod +x gitleaks
          ./gitleaks version

    - task: Bash@3
      displayName: 'Run GitLeaks Scan - MANDATORY'
      inputs:
        targetType: 'inline'
        script: |
          set -uo pipefail
          
          mkdir -p security-reports
          
          echo "🔍 Running GitLeaks secret detection scan..."
          echo ""

          # GitLeaks exit code:
          # 0 = no secrets found
          # 1 = secrets detected
          # >1 = scan/runtime error
          ./gitleaks detect \
            --source . \
            --report-path security-reports/gitleaks-report.json \
            --report-format json \
            --exit-code 1 \
            --redact \
            --verbose
          GITLEAKS_EXIT_CODE=$?

          echo ""
          echo "========================="
          echo "GitLeaks Results"
          echo "========================="
          
          # Generate summary
          if [ -f security-reports/gitleaks-report.json ]; then
            LEAK_COUNT=$(jq 'length' security-reports/gitleaks-report.json 2>/dev/null || echo "0")
            
            echo "Secrets Found: $LEAK_COUNT"
            echo ""
            
            if [ "$LEAK_COUNT" -gt 0 ]; then
              echo "##vso[task.logissue type=error]🚨 $LEAK_COUNT potential secret(s) detected"
              
              echo "🔐 Detected Secrets (first 5):"
              jq -r '.[] | "   • \(.File):\(.StartLine) - \(.RuleID)"' \
                security-reports/gitleaks-report.json 2>/dev/null | head -5 || true
              
              echo ""
              echo "GitLeaks security gate FAILED"
              echo "Deployment will not continue"
            else
              echo "✅ No secrets detected"
              echo "GitLeaks security gate PASSED"
            fi
          else
            echo "##vso[task.logissue type=error]GitLeaks report was not generated"
            GITLEAKS_EXIT_CODE=2
          fi

          echo ""
          echo "════════════════════════════════════════════════════════"

          # Mandatory gate
          if [ "$GITLEAKS_EXIT_CODE" -ne 0 ]; then
            exit "$GITLEAKS_EXIT_CODE"
          fi

          exit 0

    - task: PublishBuildArtifacts@1
      displayName: 'Publish GitLeaks Report'
      condition: always()
      inputs:
        pathToPublish: 'security-reports/gitleaks-report.json'
        artifactName: 'SecurityReports-GitLeaks'

  # ===========================
  # JOB 2: MSDO Scan (NON-FAILING)
  # ===========================
  - job: msdo_scan
    displayName: 'Microsoft Security DevOps (MSDO)'
    steps:
    - checkout: self
      submodules: true

    - task: NodeTool@0
      displayName: 'Install Node.js'
      inputs:
        versionSpec: '20.x'

    - task: Cache@2
      displayName: 'Cache npm for MSDO'
      inputs:
        key: 'npm-msdo | "$(Agent.OS)" | package-lock.json'
        path: $(npm_config_cache)
        restoreKeys: |
          npm-msdo | "$(Agent.OS)"

    - task: Bash@3
      displayName: 'Install Dependencies for Scanning'
      continueOnError: true
      inputs:
        targetType: 'inline'
        script: |
          set +e

          echo "Installing dependencies..."

          npm ci --ignore-scripts --no-audit

          if [ $? -ne 0 ]; then
            echo "npm ci failed. Falling back to npm install..."
            npm install --ignore-scripts --no-audit
          fi

          echo "Dependency installation completed."
          exit 0

    - task: MicrosoftSecurityDevOps@1
      displayName: 'Run Microsoft Security DevOps Analysis'
      continueOnError: true
      inputs:
        categories: 'secrets,code,artifacts,IaC,containers'
        tools: 'eslint,templateanalyzer,trivy'
        break: false

    - task: PublishBuildArtifacts@1
      displayName: 'Publish MSDO SARIF Results'
      condition: always()
      inputs:
        pathToPublish: '$(Build.SourcesDirectory)/.gdn'
        artifactName: 'SecurityReports-MSDO-SARIF'

    # Use the corrected analysis script from above
    - task: Bash@3
      displayName: 'Analyze MSDO Results'
      condition: always()
      continueOnError: true
      inputs:
        targetType: 'inline'
        script: |
          # [INSERT THE COMPLETE SCRIPT FROM THE TOP OF THIS RESPONSE]

  # ===========================
  # JOB 3: npm Audit (MANDATORY - HIGH/CRITICAL)
  # ===========================
  - job: npm_audit_scan
    displayName: 'npm Audit - Dependency Vulnerabilities'
    timeoutInMinutes: 5
    steps:
    - checkout: self
      fetchDepth: 1  # Shallow clone for speed

    - task: NodeTool@0
      displayName: 'Install Node.js'
      inputs:
        versionSpec: '20.x'

    # Skip dependency installation, just audit package-lock.json
    - task: Bash@3
      displayName: 'Run npm Audit - MANDATORY'
      timeoutInMinutes: 5
      inputs:
        targetType: 'inline'
        script: |
          set -uo pipefail

          echo "════════════════════════════════════════════════════════"
          echo "  NPM AUDIT - MANDATORY SECURITY GATE"
          echo "════════════════════════════════════════════════════════"

          mkdir -p security-reports

          echo ""
          echo "Running npm audit..."
          echo ""

          # Run npm audit and capture its exit code.
          # npm audit returns non-zero when vulnerabilities
          # are found or when the audit itself fails.
          npm audit --json --audit-level=high > security-reports/npm-audit-report.json 2>&1

          AUDIT_EXIT_CODE=$?

          echo ""
          echo "npm audit exit code: $AUDIT_EXIT_CODE"
          echo ""

          if [ ! -s security-reports/npm-audit-report.json ]; then
            echo "##vso[task.logissue type=error]npm audit report was not generated or is empty"
            exit 1
          fi

          echo "════════════════════════════════════════════════════════"
          echo "  NPM AUDIT SUMMARY"
          echo "════════════════════════════════════════════════════════"

          if command -v jq >/dev/null 2>&1; then

            CRITICAL=$(jq -r '.metadata.vulnerabilities.critical // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            HIGH=$(jq -r '.metadata.vulnerabilities.high // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            MODERATE=$(jq -r '.metadata.vulnerabilities.moderate // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            LOW=$(jq -r '.metadata.vulnerabilities.low // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            TOTAL=$(jq -r '.metadata.vulnerabilities.total // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            echo "Critical : $CRITICAL"
            echo "High     : $HIGH"
            echo "Moderate : $MODERATE"
            echo "Low      : $LOW"
            echo "Total    : $TOTAL"
            echo ""

            if [ "$CRITICAL" -gt 0 ] || [ "$HIGH" -gt 0 ]; then
              echo "##vso[task.logissue type=error]❌ HIGH/CRITICAL vulnerabilities found"
              echo ""
              echo "npm audit security gate FAILED"
              echo "❌ Deployment will NOT continue."
              exit 1
            fi

            if [ "$MODERATE" -gt 0 ] || [ "$LOW" -gt 0 ]; then
              echo "##vso[task.logissue type=warning]⚠️ MODERATE/LOW vulnerabilities found"
              echo "These do not block deployment but should be addressed."
            fi

          else
            echo "##vso[task.logissue type=warning]jq is not available; relying on npm audit exit code"
          fi

          # Any non-zero npm audit exit code is a failure.
          if [ "$AUDIT_EXIT_CODE" -ne 0 ]; then
            echo ""
            echo "##vso[task.logissue type=error]❌ npm audit failed with exit code $AUDIT_EXIT_CODE"
            echo "❌ Deployment will NOT continue."
            exit "$AUDIT_EXIT_CODE"
          fi

          echo ""
          echo "✅ npm audit security gate PASSED"
          echo "✅ No HIGH/CRITICAL vulnerabilities found"
          echo ""
          echo "════════════════════════════════════════════════════════"

    - task: Bash@3
      displayName: 'Analyze npm Audit Results'
      condition: always()
      inputs:
        targetType: 'inline'
        script: |
          if [ ! -f security-reports/npm-audit-report.json ] || \
             [ ! -s security-reports/npm-audit-report.json ]; then
            echo "##[warning]No audit results available"
            exit 0
          fi

          echo "════════════════════════════════════════════════════════"
          echo "  NPM AUDIT RESULTS"
          echo "════════════════════════════════════════════════════════"

          if command -v jq >/dev/null 2>&1; then
 
            CRITICAL=$(jq '.metadata.vulnerabilities.critical // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            HIGH=$(jq '.metadata.vulnerabilities.high // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            MODERATE=$(jq '.metadata.vulnerabilities.moderate // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            LOW=$(jq '.metadata.vulnerabilities.low // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            TOTAL=$(jq '.metadata.vulnerabilities.total // 0' \
              security-reports/npm-audit-report.json 2>/dev/null || echo "0")

            echo ""
            echo "Critical : $CRITICAL"
            echo "High     : $HIGH"
            echo "Moderate : $MODERATE"
            echo "Low      : $LOW"
            echo "Total    : $TOTAL"
            echo ""

            if [ "$TOTAL" -gt 0 ]; then
              echo "##[error]❌ npm audit found $TOTAL vulnerabilities"
            else
              echo "✅ No vulnerabilities found"
            fi
          fi

          echo ""
          echo "════════════════════════════════════════════════════════"

    - task: PublishBuildArtifacts@1
      displayName: 'Publish npm Audit Report'
      condition: always()
      inputs:
        pathToPublish: 'security-reports'
        artifactName: 'SecurityReports-npm'    

# ===========================
# STAGE 3: BUILD & CODE QUALITY
# ===========================
